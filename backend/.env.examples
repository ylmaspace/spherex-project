# Render environment configuration
# Copy this file to `.env` for local development (do not commit secrets).
APP_ENV=development
DATABASE_URL=sqlite:///./spherex.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
DEMO_MODE=false
IRSA_TIMEOUT_SECONDS=20
IRSA_MAX_RESULTS=100
LOG_LEVEL=INFO
